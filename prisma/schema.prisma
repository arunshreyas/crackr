// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}



model UserProfile {
  id        String @id @default(cuid())
  clerkId   String @unique @db.VarChar(255)

  // Basic profile
  email     String @db.VarChar(255)
  name      String @db.VarChar(255)
  username  String @unique @db.VarChar(255)

  // Education
  school    String @db.VarChar(255)
  grade     String @db.VarChar(50)
  stream  Stream
  onboardingCompleted Boolean @default(false)
  preferredDifficulty String? @db.VarChar(50)
  dailyGoal           Int     @default(10)
  xp             Int @default(0)
  level          Int @default(1)
  currentStreak  Int @default(0)
  longestStreak  Int @default(0)
  questionsAnswered Int @default(0)
  questionsCorrect  Int @default(0)
  lastPracticeAt DateTime?
  
  sessions       QuizSession[]
  answers        QuizAnswer[]
  xpTransactions XPTransaction[]
  achievements   UserAchievement[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum Stream {
  PCM
  PCMC
  PCB
  PCMB
}

enum QuestionType {
  MCQ
}

enum QuestionSubject {
  PHYSICS
  CHEMISTRY
  MATHEMATICS
}

enum OptionLabel {
  A
  B
  C
  D
}

model Question {
  id            String          @id @default(cuid())
  externalId    String          @unique @db.VarChar(255)
  contentHash   String          @unique @db.VarChar(64)
  text          String          @db.Text
  subject       QuestionSubject
  chapter       String          @db.VarChar(255)
  topic         String?         @db.VarChar(255)
  year          Int?
  paperTitle    String?         @db.VarChar(255)
  difficulty    String?         @db.VarChar(50)
  type          QuestionType    @default(MCQ)
  correctOption OptionLabel
  explanation   String?         @db.Text
  source        String          @default("jee_mains_pyqs_data_base") @db.VarChar(100)

  options       QuestionOption[]
  vectorRecord  QuestionVector?
  answers       QuizAnswer[]

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([subject])
  @@index([chapter])
  @@index([topic])
  @@index([year])
  @@index([difficulty])
  @@index([contentHash])
  @@index([externalId])
}

model QuestionOption {
  id         String      @id @default(cuid())
  questionId String
  question   Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label      OptionLabel
  text       String      @db.Text
  position   Int

  @@unique([questionId, label])
  @@unique([questionId, position])
  @@index([questionId])
}

model QuestionVector {
  id         String   @id @default(cuid())
  questionId String   @unique
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  embedding  Float[]
  metadata   Json
  createdAt  DateTime @default(now())

  @@index([questionId])
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

model QuizSession {
  id                   String           @id @default(cuid())
  userId               String
  user                 UserProfile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject              QuestionSubject?
  chapter              String?          @db.VarChar(255)
  difficulty           String?          @db.VarChar(50)
  status               SessionStatus    @default(ACTIVE)
  questionIds          String[]
  currentQuestionIndex Int              @default(0)
  totalQuestions       Int              @default(0)
  correctAnswers       Int              @default(0)
  accuracy             Float            @default(0)
  xpEarned             Int              @default(0)
  durationSeconds      Int              @default(0)
  lastActivityAt       DateTime         @default(now())
  completedAt          DateTime?

  answers              QuizAnswer[]

  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([createdAt])
  @@index([subject])
}

model QuizAnswer {
  id               String       @id @default(cuid())
  sessionId        String?
  session          QuizSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId           String
  user             UserProfile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId       String
  question         Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption   OptionLabel
  isCorrect        Boolean
  timeTakenSeconds Int?

  createdAt        DateTime     @default(now())

  @@unique([sessionId, questionId])
  @@index([userId])
  @@index([sessionId])
  @@index([questionId])
  @@index([createdAt])
  @@index([isCorrect])
}

model XPTransaction {
  id        String       @id @default(cuid())
  userId    String
  user      UserProfile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  reason    String       @db.VarChar(255)
  sessionId String?
  createdAt DateTime     @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([sessionId])
}

model Achievement {
  id               String            @id @default(cuid())
  code             String            @unique @db.VarChar(100)
  title            String            @db.VarChar(255)
  description      String            @db.Text
  icon             String            @db.VarChar(50)
  xpReward         Int               @default(50)
  category         String            @db.VarChar(50)
  requirementValue Int               @default(1)
  userAchievements UserAchievement[]
  createdAt        DateTime          @default(now())
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlockedAt    DateTime    @default(now())

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
}


 